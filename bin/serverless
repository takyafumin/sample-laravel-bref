#!/bin/sh
# Run the Serverless Framework (osls) container with temporary AWS credentials
# exported from a host profile (works with SSO: run `aws sso login` first), or
# in GitHub Actions, with the credentials already in the environment
# (aws-actions/configure-aws-credentials). Locally the profile is always used,
# like the other bin/aws-* scripts, even if AWS_* variables are set.
# Usage: bin/serverless <serverless args...>
# Requires: aws CLI v2, jq, docker
set -eu
cd "$(dirname "$0")/.."
if [ "${GITHUB_ACTIONS:-}" != true ]; then
  profile="${AWS_PROFILE:-takyafumin}"
  if ! creds=$(aws configure export-credentials --profile "$profile" --format process); then
    echo "Could not get AWS credentials for profile '$profile' (try: aws sso login --profile $profile)" >&2
    exit 1
  fi
  # Parse the JSON output instead of evaluating shell code. Credentials go through
  # this process's environment, never the command line.
  AWS_ACCESS_KEY_ID=$(printf '%s' "$creds" | jq -er '.AccessKeyId')
  AWS_SECRET_ACCESS_KEY=$(printf '%s' "$creds" | jq -er '.SecretAccessKey')
  AWS_SESSION_TOKEN=$(printf '%s' "$creds" | jq -r '.SessionToken // empty')
fi
AWS_SESSION_TOKEN="${AWS_SESSION_TOKEN:-}"
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
# Build the image first, with its output on stderr: without a TTY (CI), an
# implicit build by `docker compose run` prints its log to stdout, ahead of the
# command's output that callers parse (e.g. bin/aws-release reads JSON).
docker compose build --quiet serverless >&2
exec docker compose run --rm -T \
  -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_SESSION_TOKEN \
  serverless "$@"
