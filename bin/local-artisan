#!/bin/sh
# Run an artisan command through the local `artisan` Lambda (Bref console runtime via RIE).
# Usage: bin/local-artisan "migrate --force"
set -eu
if [ $# -eq 0 ]; then
  echo "usage: $0 \"<artisan command>\"" >&2
  exit 64
fi
payload=$(printf '%s' "$*" | sed 's/\\/\\\\/g; s/"/\\"/g')
response=$(curl -sS "http://127.0.0.1:${ARTISAN_PORT:-9001}/2015-03-31/functions/function/invocations" -d "\"$payload\"")
if command -v jq >/dev/null 2>&1; then
  printf '%s' "$response" | jq -r '.output // .'
  exit "$(printf '%s' "$response" | jq -r '.exitCode // 1')"
fi
printf '%s\n' "$response"
