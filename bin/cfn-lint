#!/bin/sh
# Validate the CloudFormation template generated by `bin/serverless package`.
# Not part of bin/lint: packaging resolves SSM parameters and needs AWS credentials.
# Usage: bin/cfn-lint [stage]   (default: dev)
set -eu
cd "$(dirname "$0")/.."
stage="${1:-dev}"

bin/serverless package --stage "$stage" >/dev/null
# W3005: redundant DependsOn in resources generated by osls (not ours)
docker compose run --rm -T cfn-lint --regions ap-northeast-1 --ignore-checks W3005 \
  -- cloudformation-template-update-stack.json
echo "cfn-lint: OK"
