#!/bin/sh
# Deploy to AWS without dev dependencies, then restore them.
# Usage: bin/deploy [stage] [serverless deploy options...]   (default stage: dev)
# Example: bin/deploy dev --force   (redeploy even without changes)
set -eu
cd "$(dirname "$0")/.."
stage="dev"
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
  stage="$1"
  shift
fi
# Restore dev dependencies on exit, keeping the deploy's exit status even if
# the restore itself fails.
restore() {
  status=$?
  trap - EXIT
  if ! composer install --no-interaction --quiet; then
    echo "warning: failed to restore dev dependencies (run: composer install)" >&2
  fi
  exit "$status"
}
trap restore EXIT
composer install --no-dev --optimize-autoloader --prefer-dist --no-interaction --quiet
bin/serverless deploy --stage "$stage" "$@"
