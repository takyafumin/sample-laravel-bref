#!/bin/sh
# Deploy a stage and run its pending migrations (used by .github/workflows/deploy.yml).
# - No stack yet: deploy, then migrate.
# - The repository has migrations that the deployed database has not run:
#   deploy in maintenance mode, migrate, then deploy again (see README).
# - Otherwise: deploy only.
# If migrating fails, the stage stays in maintenance mode.
# Usage: bin/aws-release [stage]   (default: dev)
# Requires: aws CLI, jq, docker, PHP and Composer (bin/deploy)
set -eu
cd "$(dirname "$0")/.."
stage="${1:-dev}"
region=ap-northeast-1
stack="sample-laravel-bref-$stage"

# GitHub Actions: the credentials in the environment (OIDC). Locally: always the
# profile, like the other bin/aws-* scripts, even if AWS_* variables are set.
aws_() {
  if [ "${GITHUB_ACTIONS:-}" = true ]; then
    aws --region "$region" "$@"
  else
    aws --profile "${AWS_PROFILE:-takyafumin}" --region "$region" "$@"
  fi
}

artisan() {
  bin/serverless bref:cli --stage "$stage" --args="$1"
}

# The first invocation after a deploy can fail with S3FilesMountTimeoutException.
migrate() {
  attempt=1
  until artisan "migrate --force"; do
    if [ "$attempt" -ge 3 ]; then
      echo "Migration failed." >&2
      return 1
    fi
    attempt=$((attempt + 1))
    echo "Retrying the migration in 20 seconds..." >&2
    sleep 20
  done
}

# Prints the repository's migrations that the deployed database has not run.
# Prints all of them if the status cannot be read (e.g. no database yet).
pending_migrations() {
  # bref:cli prints the invocation result as indented JSON, from a line "{" to a
  # line "}" ({"exitCode":..,"output":".."}), then the function's logs. Parse
  # only that block, so that other output (e.g. docker) cannot break it.
  raw=$(artisan "migrate:status" 2>&1) || true
  status=$(printf '%s\n' "$raw" | awk '/^\{$/ { found = 1 } found { print } found && /^\}$/ { exit }' | jq -r '.output // empty' 2>/dev/null) || status=""
  if [ -z "$status" ]; then
    {
      echo "warning: could not read the migration status; treating every migration as pending."
      printf '%s\n' "$raw" | sed 's/^/    /'
    } >&2
  fi
  for file in database/migrations/*.php; do
    name=$(basename "$file" .php)
    # One line per migration: "  <name> ........ [<batch>] Ran"
    if ! printf '%s\n' "$status" | grep -E "^ *${name} \.+ \[[0-9]+\] Ran *$" >/dev/null; then
      echo "$name"
    fi
  done
}

# Only "does not exist" means a first deploy; fail on any other error
# (expired credentials, throttling) instead of deploying without maintenance.
if ! describe=$(aws_ cloudformation describe-stacks --stack-name "$stack" 2>&1); then
  case "$describe" in
    *"does not exist"*) ;;
    *)
      printf '%s\n' "$describe" >&2
      exit 1
      ;;
  esac
  echo "==> First deploy of $stack"
  bin/deploy "$stage"
  echo "==> Migrating"
  migrate
  exit 0
fi

pending=$(pending_migrations)
if [ -z "$pending" ]; then
  echo "==> No pending migrations: deploying $stack"
  bin/deploy "$stage"
  exit 0
fi

echo "==> Pending migrations:"
# shellcheck disable=SC2086 # one migration per line
printf "    %s\n" $pending
echo "==> Deploying $stack in maintenance mode"
bin/deploy "$stage" --param="maintenance=1"
echo "==> Migrating"
migrate
echo "==> Deploying $stack (maintenance mode off)"
bin/deploy "$stage"
