#!/bin/sh
# Run the Playwright E2E tests (e2e/) in a container.
# Usage: bin/e2e [--ui | --video] [<base-url>] [-- <playwright test options...>]
#   (no URL)     start the local stack (docker compose) and test it
#   <base-url>   test a deployed endpoint, e.g. the API Gateway URL
#   --video      record every test as a video, slowed down to follow by eye
#                (e2e/test-results/**/video.webm; E2E_SLOW_MO=<ms>, default 500)
#   --ui         open Playwright's UI mode at http://127.0.0.1:9323 (E2E_UI_PORT)
#                to run tests and see the browser at every step; Ctrl+C to stop
# Requires: docker (and jq for the local stack, via bin/local-artisan)
set -eu
cd "$(dirname "$0")/.."

usage() {
  echo "usage: $0 [--ui | --video] [<base-url>] [-- <playwright test options...>]" >&2
  exit 64
}

mode="test"
while [ $# -gt 0 ]; do
  case "$1" in
    --ui)
      [ "$mode" = test ] || usage
      mode=ui
      shift
      ;;
    --video)
      [ "$mode" = test ] || usage
      mode=video
      shift
      ;;
    *) break ;;
  esac
done

base_url=""
case "${1:-}" in
  http://* | https://*)
    base_url="$1"
    shift
    ;;
  "" | --) ;;
  *)
    echo "The base URL must start with http:// or https:// (got: $1)." >&2
    usage
    ;;
esac
if [ $# -gt 0 ]; then
  [ "$1" = "--" ] || usage
  shift
fi

if [ -z "$base_url" ]; then
  base_url="http://gateway:8000"
  docker compose up -d web artisan gateway
  # The artisan RIE needs a moment to accept invocations after startup.
  attempt=1
  until bin/local-artisan "migrate --force" >/dev/null 2>&1; do
    if [ "$attempt" -ge 30 ]; then
      echo "The local stack did not become ready (bin/local-artisan \"migrate --force\" kept failing)." >&2
      bin/local-artisan "migrate --force" >&2 || true
      exit 1
    fi
    attempt=$((attempt + 1))
    sleep 2
  done
fi
export E2E_BASE_URL="$base_url"
setup='npm ci --no-audit --no-fund --loglevel=error'

case "$mode" in
  ui)
    port="${E2E_UI_PORT:-9323}"
    echo "Playwright UI mode for $base_url: open http://127.0.0.1:$port/ in your browser (Ctrl+C to stop)"
    # The UI listens on all interfaces inside the container, but is published on
    # the host's loopback only.
    tty="-T"
    if [ -t 0 ] && [ -t 1 ]; then
      tty=""
    fi
    # shellcheck disable=SC2086 # $tty is empty or a single flag
    exec docker compose run --rm $tty -p "127.0.0.1:$port:9323" e2e \
      sh -c "$setup"' && npx playwright test --ui-host=0.0.0.0 --ui-port=9323 "$@"' sh "$@"
    ;;
  video)
    echo "Recording E2E tests against $base_url (videos: e2e/test-results/)"
    rm -rf e2e/test-results
    status=0
    E2E_VIDEO=1 docker compose run --rm -T e2e \
      sh -c "$setup"' && npx playwright test "$@"' sh "$@" || status=$?
    echo "Videos (tests that use a browser):"
    find e2e/test-results -name 'video.webm' | sort | sed 's/^/  /'
    exit "$status"
    ;;
  *)
    echo "Running E2E tests against $base_url (traces of failed tests: e2e/test-results/)"
    rm -rf e2e/test-results
    exec docker compose run --rm -T e2e \
      sh -c "$setup"' && npx playwright test "$@"' sh "$@"
    ;;
esac
